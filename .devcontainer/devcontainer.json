{
  "name": "AIHPC Advanced — Scientific Computing Lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    },
    "ghcr.io/devcontainers/features/r:1": {
      "version": "4.4",
      "installRMarkdown": true
    },
    "ghcr.io/devcontainers/features/julia:1": {
      "version": "1.10"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    3000,
    8888,
    8080
  ],
  "portsAttributes": {
    "3000": { "label": "Next.js dev server", "onAutoForward": "notify" },
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" },
    "8080": { "label": "Python http.server", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "Ikuyadeu.r",
        "julialang.language-julia",
        "ms-vscode.vscode-json",
        "redhat.vscode-yaml",
        "GitHub.copilot",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/3.11/bin/python",
        "python.languageServer": "Pylance",
        "jupyter.askForKernelRestart": false,
        "jupyter.runStartupCommands": [
          "%load_ext autoreload",
          "%autoreload 2"
        ],
        "R.rterm.linux": "/usr/local/bin/R",
        "R.rmarkdown.previewLocation": "beside",
        "julia.executablePath": "/usr/local/julia/bin/julia",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.autoSave": "afterDelay",
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorTheme": "Default Dark+"
      }
    }
  },
  "remoteEnv": {
    "AIHPC_LAB": "codespaces",
    "AIHPC_REPO": "https://github.com/testdemoqwenai2025-creator/DemoAIHPC"
  },
  "secrets": {
    "OPENAI_API_KEY": { "description": "Optional: for AI code completion in Copilot" }
  },
  "comment": "Free tier for GitHub personal accounts: 120 core-hours/month + 15 GB storage. See https://docs.github.com/en/billing/managing-billing-for-github-actions/about-billing-for-github-actions#calculating-minute-and-storage-spending. Users who hit the quota can run locally with `npm run dev` (the platform already supports this)."
}
